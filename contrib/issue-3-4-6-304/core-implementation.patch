+      <output id="loading">{String(wallet.loading)}</output>
+      <output id="error">{wallet.error instanceof Error ? wallet.error.message : ""}</output>
+      <button id="connect" onClick={() => void wallet.connect().catch(() => {})}>Connect</button>
